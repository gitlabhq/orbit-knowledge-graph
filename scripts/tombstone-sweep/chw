#!/usr/bin/env bash
# Runs SQL against the prod graph ClickHouse as the indexer's own user
# (gkg_writer), by exec'ing curl inside a dispatcher pod. The password is read
# in-pod and never leaves it, and the endpoint comes from the pod's mounted
# config rather than being hardcoded here.
#
# The ClickHouse Cloud console gateway caps statements at ~30s, so it cannot run
# the sweep statements at all; this relay has no such cap. It also runs with the
# exact grants production has, which is how the system.mutations restriction was
# discovered.
#
#   echo "SELECT 1 FORMAT JSONEachRow" | .bench/tombstone-sweep/chw
set -uo pipefail
POD=${CHW_POD:-$(kubectl -n "${CHW_NAMESPACE:-gkg}" get pods \
  -l app.kubernetes.io/component=dispatcher -o name | head -1 | cut -d/ -f2)}
[ -z "$POD" ] && { echo "chw: no dispatcher pod found" >&2; exit 1; }
kubectl -n "${CHW_NAMESPACE:-gkg}" exec -i "$POD" -- sh -c '
conf=$(ls /app/config/*.yaml 2>/dev/null | head -1)
gv() { sed -n "/^graph:/,/^[a-z]/p" "$conf" | sed -n "s/^[[:space:]]*$1:[[:space:]]*\"\{0,1\}\([^\"]*\)\"\{0,1\}[[:space:]]*$/\1/p" | head -1; }
url=$(gv url); db=$(gv database); user=$(gv username)
exec 3<<EOF
url = "$url/?database=$db"
user = "$user:$(cat /etc/secrets/graph/password)"
EOF
exec curl -sS --max-time "${CHW_MAX_TIME:-5400}" --config /dev/fd/3 --data-binary @-
'
