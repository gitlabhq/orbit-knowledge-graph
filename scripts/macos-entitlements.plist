<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      orbit loads the DuckDB `fts` extension at runtime (INSTALL fts; LOAD fts;
      in crates/duckdb-client/src/client.rs). That extension is a separate dylib
      signed with DuckDB's Apple Team ID. Under the hardened runtime, macOS
      library validation refuses to map a library with a Team ID different from
      the host binary's, so loading fails with "different Team IDs". This
      entitlement is the Apple-sanctioned exception that lets a hardened,
      notarized binary load libraries signed by another team.
    -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
