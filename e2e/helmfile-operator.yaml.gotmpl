{{ $sha := requiredEnv "E2E_SHA" }}
{{ $kctx := env "KCTX" | default "gke_gl-knowledgegraph-prj-f2eec59d_us-central1-a_e2e-harness" }}
{{ $v := fromYaml (readFile "config/versions.yaml") }}

# Operator variant of the e2e helmfile.
#
# Identical to helmfile.yaml.gotmpl for bootstrap, infra, GitLab, pg-cdc-setup,
# and siphon. Replaces the standalone `gkg` helm release with:
#   1. operator-install: deploys the Orbit CRD and a minimal operator Deployment.
#   2. orbit-cr: applies an Orbit CR that the operator reconciles into the gkg
#      chart objects.
#
# Siphon remains a standalone release because it is Analytics-owned and its
# lifecycle is independent of Orbit. NATS is also standalone.

helmDefaults:
  wait: true
  timeout: 600
  kubeContext: {{ $kctx }}

repositories:
  - name: gitlab-devel
    url: https://gitlab.com/api/v4/projects/3828396/packages/helm/devel
  - name: nats
    url: https://nats-io.github.io/k8s/helm/charts
  - name: siphon
    url: https://gitlab.com/api/v4/projects/76780115/packages/helm/stable
  - name: bitnami
    url: https://charts.bitnami.com/bitnami

releases:
  # --- Phase: bootstrap (namespaces + secrets) ---
  - name: bootstrap
    namespace: e2e-{{ $sha }}-gkg
    createNamespace: true
    chart: charts/e2e-bootstrap
    labels:
      phase: bootstrap
      component: bootstrap
    values:
      - values/bootstrap.yaml.gotmpl

  # --- Phase: infra ---
  - name: nats
    namespace: e2e-{{ $sha }}-nats
    createNamespace: true
    chart: nats/nats
    version: {{ $v.nats.chart }}
    labels:
      phase: infra
      component: nats
    needs:
      - e2e-{{ $sha }}-gkg/bootstrap
    values:
      - values/nats.yaml

  - name: clickhouse
    namespace: e2e-{{ $sha }}-clickhouse
    createNamespace: true
    chart: charts/clickhouse
    labels:
      phase: infra
      component: clickhouse
    needs:
      - e2e-{{ $sha }}-gkg/bootstrap
    values:
      - values/clickhouse.yaml.gotmpl

  - name: postgresql
    namespace: e2e-{{ $sha }}-gitlab
    createNamespace: true
    chart: bitnami/postgresql
    version: {{ $v.postgresql.chart }}
    labels:
      phase: infra
      component: postgresql
    needs:
      - e2e-{{ $sha }}-gkg/bootstrap
    values:
      - values/postgresql.yaml.gotmpl

  - name: redis
    namespace: e2e-{{ $sha }}-gitlab
    createNamespace: true
    chart: bitnami/redis
    version: {{ $v.redis.chart }}
    labels:
      phase: infra
      component: redis
    needs:
      - e2e-{{ $sha }}-gkg/bootstrap
    values:
      - values/redis.yaml.gotmpl

  - name: gitlab
    namespace: e2e-{{ $sha }}-gitlab
    createNamespace: true
    chart: gitlab-devel/gitlab
    version: {{ $v.gitlab.chart }}
    labels:
      phase: infra
      component: gitlab
    needs:
      - e2e-{{ $sha }}-gkg/bootstrap
      - e2e-{{ $sha }}-gitlab/postgresql
      - e2e-{{ $sha }}-gitlab/redis
    timeout: 600
    values:
      - values/gitlab.yaml.gotmpl

  # --- Phase: pipeline ---
  - name: pg-cdc-setup
    namespace: e2e-{{ $sha }}-gitlab
    chart: charts/pg-cdc-setup
    labels:
      phase: pipeline
      component: pg-cdc-setup
    needs:
      - e2e-{{ $sha }}-gitlab/gitlab
      - e2e-{{ $sha }}-gitlab/postgresql
    timeout: 120
    values:
      - values/pg-cdc-setup.yaml.gotmpl

  - name: siphon
    namespace: e2e-{{ $sha }}-siphon
    createNamespace: true
    chart: siphon/siphon
    version: {{ $v.siphon.chart }}
    labels:
      phase: pipeline
      component: siphon
    needs:
      - e2e-{{ $sha }}-nats/nats
      - e2e-{{ $sha }}-clickhouse/clickhouse
      - e2e-{{ $sha }}-gitlab/pg-cdc-setup
    values:
      - values/siphon.yaml.gotmpl

  # --- Phase: operator (replaces standalone gkg helm release) ---
  - name: operator-install
    namespace: e2e-{{ $sha }}-gkg
    chart: charts/operator-install
    labels:
      phase: operator
      component: operator
    needs:
      - e2e-{{ $sha }}-gkg/bootstrap
    values:
      - values/operator-install.yaml.gotmpl

  - name: orbit-cr
    namespace: e2e-{{ $sha }}-gkg
    chart: charts/orbit-cr
    labels:
      phase: operator
      component: orbit
    needs:
      - e2e-{{ $sha }}-gkg/operator-install
      - e2e-{{ $sha }}-nats/nats
      - e2e-{{ $sha }}-clickhouse/clickhouse
    values:
      - values/orbit-cr.yaml.gotmpl
