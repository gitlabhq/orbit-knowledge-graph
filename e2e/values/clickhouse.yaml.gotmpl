password: {{ requiredEnv "E2E_CH_DEFAULT_PASS" | quote }}

# E2E_CH_REPLICAS=3 deploys a replicated cluster with embedded Keeper; the
# default stays a single node.
replicas: {{ env "E2E_CH_REPLICAS" | default "1" }}

persistence:
  enabled: false
  size: 20Gi

users:
  siphon:
    password: {{ requiredEnv "E2E_CH_SIPHON_PASS" | quote }}
  gitlab:
    password: {{ requiredEnv "E2E_CH_GITLAB_PASS" | quote }}
