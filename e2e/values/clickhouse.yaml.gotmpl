{{ $replicas := env "E2E_CH_REPLICAS" | default "1" | atoi }}
password: {{ requiredEnv "E2E_CH_DEFAULT_PASS" | quote }}

replicas: {{ $replicas }}

# A replica that comes back on an empty disk has lost its database metadata, so
# the cluster keeps its data across the pod kills in ch-chaos.sh.
persistence:
  enabled: {{ gt $replicas 1 }}
  size: 20Gi

users:
  siphon:
    password: {{ requiredEnv "E2E_CH_SIPHON_PASS" | quote }}
  gitlab:
    password: {{ requiredEnv "E2E_CH_GITLAB_PASS" | quote }}
