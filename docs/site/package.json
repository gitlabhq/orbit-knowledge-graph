{
  "name": "orbit-architecture",
  "description": "The GitLab Orbit architecture pages, rendered with the Orbit site kit.",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun run --filter @orbit/architecture dev",
    "build": "bun run --filter @orbit/architecture build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test"
  },
  "dependencies": {
    "@gitlab-org/orbit-site": "^0.1.2",
    "@tanstack/react-router": "^1.170.17",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vite": "^8.1.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^7.0.2"
  }
}
