{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbit.gitlab.com/extensions/v1alpha1/package.json",
  "title": "Orbit extensions package document, v1alpha1",
  "description": "A declarative package that a provider serves. Orbit reads every name in it as data only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "graph", "authorization", "storage", "sources"],
  "properties": {
    "apiVersion": { "const": "orbit.gitlab.com/extensions/v1alpha1" },
    "kind": { "const": "Package" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "$ref": "#/$defs/packageName" },
        "version": { "$ref": "#/$defs/semver" }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entities"],
      "properties": {
        "entities": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/entity" },
          "propertyNames": { "$ref": "#/$defs/entityName" }
        },
        "relationships": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/relationship" },
          "propertyNames": { "$ref": "#/$defs/relationshipName" }
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entities"],
      "properties": {
        "entities": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scope"],
            "properties": {
              "scope": { "type": "string", "enum": ["namespace"] }
            }
          },
          "propertyNames": { "$ref": "#/$defs/entityName" }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["store", "entities"],
      "properties": {
        "store": { "type": "string", "enum": ["graph"] },
        "entities": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/storageEntity" },
          "propertyNames": { "$ref": "#/$defs/entityName" }
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "entities"],
      "properties": {
        "source": { "type": "string", "enum": ["data_lake"] },
        "entities": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/sourceEntity" },
          "propertyNames": { "$ref": "#/$defs/entityName" }
        }
      }
    },
    "live": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entities"],
      "properties": {
        "entities": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/liveEntity" },
          "propertyNames": { "$ref": "#/$defs/entityName" }
        }
      }
    }
  },
  "$defs": {
    "packageName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "entityName": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$"
    },
    "relationshipName": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "propertyType": {
      "type": "string",
      "enum": ["int64", "string", "bool", "float", "timestamp", "date"]
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "properties"],
      "properties": {
        "label": { "type": "string" },
        "cited_by": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "properties": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": { "type": { "$ref": "#/$defs/propertyType" } }
          },
          "propertyNames": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variants"],
      "properties": {
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/relationshipVariant" }
        }
      }
    },
    "relationshipVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "oneOf": [
        { "required": ["fk"], "not": { "required": ["table"] } },
        { "required": ["table"], "not": { "required": ["fk"] } }
      ],
      "properties": {
        "from": { "$ref": "#/$defs/entityName" },
        "to": { "$ref": "#/$defs/entityName" },
        "fk": {
          "type": "object",
          "additionalProperties": false,
          "required": ["column"],
          "properties": {
            "column": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
          }
        },
        "table": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
      }
    },
    "storageEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns", "sort_key"],
      "properties": {
        "columns": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string" },
          "propertyNames": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        },
        "sort_key": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "sourceEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tables", "order_by"],
      "properties": {
        "tables": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        },
        "order_by": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "liveEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["properties", "operation"],
      "properties": {
        "properties": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": { "type": { "$ref": "#/$defs/propertyType" } }
          },
          "propertyNames": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        },
        "operation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "keys"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "keys": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
            },
            "max_keys": { "type": "integer", "minimum": 1 },
            "timeout_ms": { "type": "integer", "minimum": 1 }
          }
        },
        "search": { "$ref": "#/$defs/search" }
      }
    },
    "searchMatch": {
      "type": "string",
      "enum": ["contains", "equals", "range"]
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "fields"],
      "properties": {
        "operation": { "type": "string", "minLength": 1 },
        "fields": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/searchMatch" },
          "propertyNames": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        },
        "inbound": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "const": "$cited_by" },
            "propertyNames": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
          },
          "propertyNames": { "$ref": "#/$defs/relationshipName" }
        },
        "max_rows": { "type": "integer", "minimum": 1 },
        "timeout_ms": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
