domains[9]:
  - name: agents
    nodes[1]:
      - name: AgentSession
        props[5]: "id:int — Governance session ID.","flow_type:enum — Kind of flow, from the workflow definition with its version dropped (developer/v1 becomes developer). Unrecognized definitions, and flows addressed by display name, are 'other'.","source:enum — Where the session was recorded. Only gitlab_duo sessions are indexed today.","project_id:int — Owning project ID.","session_started_at:datetime — When the session started."
        out[2]: "CREATED_MR → [MergeRequest]","IN_PROJECT → [Project]"
        in[0]:
  - name: ci
    nodes[6]:
      - name: Deployment
        props[16]: "id:int — Unique ID.","iid:int — Project-scoped deployment number.","project_id:int — Owning project ID.","ref:string — Git ref (branch or tag) deployed.","tag:bool — Whether the ref is a tag.","sha:string — Deployed commit SHA.","status:enum — Execution status.","deployable_type:string — Polymorphic type (typically CommitStatus, the STI base class for Ci::Build).","deployable_id:int? — Deployable ID.","on_stop:string — Job name that stops this deployment.","archived:bool — Whether archived.","created_at:datetime? — Creation timestamp.","finished_at:datetime? — Execution finish timestamp.","updated_at:datetime? — Last update timestamp.","environment_id:int — Target environment ID.","user_id:int? — Deploying user ID."
        out[2]: "IN_ENVIRONMENT → [Environment]","IN_PROJECT → [Project]"
        in[2]: "DEPLOYED_BY ← [User]","DEPLOYED_TO ← [MergeRequest]"
      - name: Environment
        props[18]: "id:int — Unique ID.","project_id:int — Owning project ID.","name:string — Name (e.g. 'production', 'staging', 'review/feature-x').","slug:string — URL-safe slug derived from name.","external_url:string — External URL of the environment.","environment_type:string — Category from name prefix before first '/' (e.g. 'review'); empty when no '/'.","state:enum — Lifecycle state.","tier:enum — Deployment tier.","auto_stop_at:datetime? — Scheduled auto-stop timestamp.","auto_delete_at:datetime? — Scheduled auto-delete timestamp.","auto_stop_setting:enum — Auto-stop behavior.","cluster_agent_id:int? — Associated Kubernetes cluster agent ID.","kubernetes_namespace:string — Target Kubernetes namespace.","flux_resource_path:string — Flux resource path for GitOps.","description:string — Free-form description.","created_at:datetime? — Creation timestamp.","updated_at:datetime? — Last update timestamp.","merge_request_id:int? — MR that created this review environment."
        out[2]: "CREATED_FOR_MR → [MergeRequest]","IN_PROJECT → [Project]"
        in[1]: "IN_ENVIRONMENT ← [Deployment]"
      - name: Job
        props[29]: "id:int — Unique ID.","name:string — Job name from .gitlab-ci.yml.","status:enum — Execution status.","ref:string — Branch or tag name.","tag:bool? — Whether running on a git tag.","allow_failure:bool — Whether failure is allowed without failing the pipeline.","coverage:string — Reported code coverage percentage.","environment:string — Target environment name (e.g. production, staging).","when:enum — Run condition.","retried:bool? — Whether superseded by a retry.","failure_reason:enum — Failure reason.","created_at:datetime? — Creation timestamp.","started_at:datetime? — Execution start timestamp.","finished_at:datetime? — Execution finish timestamp.","queued_at:datetime? — Queue timestamp.","duration:int? — Execution time in seconds (finished_at - started_at). Null until the job has started and finished. Trigger (bridge) jobs cover downstream pipeline time, not runner time.","queued_duration:int? — Queue time in seconds, up to started_at or, if never started, finished_at. Null while waiting, or when queued_at is after started_at (re-queued job; wait unknown).","type:string — STI class: Ci::Build, Ci::Bridge, or GenericCommitStatus.","runner_id:int? — Executing runner ID.","timeout:int? — Effective timeout in seconds.","timeout_source:enum — Timeout origin: project, runner, or job.","exit_code:int? — Process exit code from the runner.","scheduling_type:enum — Scheduling mode: stage or DAG.","project_id:int — Owning project ID.","user_id:int? — Triggering user ID.","upstream_pipeline_id:int? — Upstream pipeline ID for bridge jobs.","stage_id:int? — Containing stage ID.","pipeline_id:int? — Containing pipeline ID. Source column is commit_id (legacy Rails naming).","auto_canceled_by_id:int? — Pipeline ID that auto-canceled this job."
        out[6]: "AUTO_CANCELED_BY → [Pipeline]","IN_PIPELINE → [Pipeline]","IN_PROJECT → [Project]","RUNS_ON → [Runner]","TRIGGERED_BY_PIPELINE → [Pipeline]","TRIGGERS_PIPELINE → [Pipeline]"
        in[3]: "HAS_JOB ← [Pipeline, Stage]","RAN_BY ← [SecurityScan]","TRIGGERED ← [User]"
      - name: Pipeline
        props[21]: "id:int — Unique ID.","iid:int? — Project-scoped pipeline number.","sha:string — Commit SHA the pipeline runs against.","ref:string — Branch or tag name.","status:enum — Execution status.","source:enum — Trigger source.","tag:bool — Whether running on a git tag.","duration:int? — Wall-clock duration in seconds (first job start to last job finish, excluding queued time).","failure_reason:enum — Failure reason.","created_at:datetime? — Creation timestamp.","started_at:datetime? — Execution start timestamp.","finished_at:datetime? — Execution finish timestamp.","committed_at:datetime? — Commit timestamp.","updated_at:datetime? — Last update timestamp.","before_sha:string — Previous commit SHA before the triggering push.","yaml_errors:string — CI config parsing errors.","protected:bool? — Whether the ref is protected.","project_id:int — Owning project ID.","user_id:int? — Triggering user ID.","merge_request_id:int? — Triggering MR ID.","auto_canceled_by_id:int? — Pipeline ID that auto-canceled this one."
        out[5]: "AUTO_CANCELED_BY → [Pipeline]","CHILD_OF → [Pipeline]","HAS_JOB → [Job]","HAS_STAGE → [Stage]","IN_PROJECT → [Project]"
        in[8]: "AUTO_CANCELED_BY ← [Job, Pipeline]","BUILT_BY ← [Package, PackageFile]","CHILD_OF ← [Pipeline]","HAS_HEAD_PIPELINE ← [MergeRequest]","IN_PIPELINE ← [Job, SecurityScan]","TRIGGERED ← [MergeRequest, User]","TRIGGERED_BY_PIPELINE ← [Job]","TRIGGERS_PIPELINE ← [Job]"
      - name: Runner
        props[12]: "id:int — Unique ID.","runner_type:enum — Scope: instance, group, or project.","name:string — Human-readable runner name.","description:string — Maintainer-provided description.","active:bool — Whether currently accepting jobs.","locked:bool — Whether locked to its assignment.","run_untagged:bool — Whether it picks up untagged jobs.","access_level:enum — Whether restricted to protected refs.","maximum_timeout:int? — Max job timeout in seconds.","organization_id:int? — Cell organization ID.","created_at:datetime? — Registration timestamp.","contacted_at:datetime? — Last contact timestamp."
        out[0]:
        in[1]: "RUNS_ON ← [Job]"
      - name: Stage
        props[8]: "id:int — Unique ID.","name:string — Stage name (e.g. build, test, deploy).","status:enum — Execution status.","position:int? — Order within the pipeline (0-indexed).","created_at:datetime? — Creation timestamp.","updated_at:datetime? — Last update timestamp.","project_id:int — Owning project ID.","pipeline_id:int? — Containing pipeline ID."
        out[2]: "HAS_JOB → [Job]","IN_PROJECT → [Project]"
        in[1]: "HAS_STAGE ← [Pipeline]"
  - name: code_review
    nodes[3]:
      - name: MergeRequest
        props[44]: "id:int — Unique ID.","iid:int? — Project-scoped merge request number.","title:string — Title.","description:string — Description body (markdown).","source_branch:string — Source branch name.","target_branch:string — Target branch name.","state:enum — Current state.","merge_status:string — Mergeability status: unchecked, preparing, checking, can_be_merged, cannot_be_merged, cannot_be_merged_recheck, cannot_be_merged_rechecking.","draft:bool — Whether this is a draft/WIP merge request.","squash:bool — Whether to squash commits on merge.","created_at:datetime? — Creation timestamp.","updated_at:datetime? — Last update timestamp.","merge_commit_sha:string — Merge commit SHA.","discussion_locked:bool? — Whether discussions are locked.","prepared_at:datetime? — Preparation timestamp.","project_id:int — Owning project ID. Stored on the node for redaction without an edge lookup.","merged_commit_id:int? — Synthetic Commit id the MR was merged at. NULL until merged, then immutable.","latest_build_started_at:datetime? — Latest CI build start timestamp.","latest_build_finished_at:datetime? — Latest CI build finish timestamp.","first_deployed_to_production_at:datetime? — First production deployment timestamp.","merged_at:datetime? — Merge timestamp.","latest_closed_at:datetime? — Most recent close timestamp.","first_comment_at:datetime? — First comment timestamp.","first_commit_at:datetime? — First commit authored timestamp.","last_commit_at:datetime? — Last commit authored timestamp.","diff_size:int? — Total diff size in bytes.","modified_paths_size:int? — Number of modified file paths.","commits_count:int? — Number of commits.","first_approved_at:datetime? — First approval timestamp.","first_reassigned_at:datetime? — First reassignment timestamp.","added_lines:int? — Lines added across all files.","removed_lines:int? — Lines removed across all files.","first_contribution:bool — Whether this is the author's first contribution to the project.","reviewer_first_assigned_at:datetime? — First reviewer assignment timestamp.","author_id:int? — Author user ID.","merge_user_id:int? — User ID who merged.","updated_by_id:int? — User ID who last updated.","last_edited_by_id:int? — User ID who last edited the description.","closed_by_id:int? — User ID who most recently closed.","milestone_id:int? — Associated milestone ID.","source_project_id:int? — Source project ID (may differ from target for cross-project MRs).","head_pipeline_id:int? — Pipeline ID on the head commit.","latest_merge_request_diff_id:int? — Most recent diff snapshot ID.","diff:string? — Full unified diff. Resolved from GitLab at query time."
        out[14]: "CLOSES → [WorkItem]","DEPLOYED_TO → [Deployment]","FIXES → [Vulnerability]","HAS_DIFF → [MergeRequestDiff]","HAS_HEAD_PIPELINE → [Pipeline]","HAS_LABEL → [Label]","HAS_LATEST_DIFF → [MergeRequestDiff]","HAS_NOTE → [Note]","IN_MILESTONE → [Milestone]","IN_PROJECT → [Project]","MENTIONS → [MergeRequest, WorkItem]","MERGED_AT_COMMIT → [Commit]","SOURCE_PROJECT → [Project]","TRIGGERED → [Pipeline]"
        in[12]: "APPROVED ← [User]","ASSIGNED ← [User]","AUTHORED ← [User]","CLOSED ← [User]","CREATED_FOR_MR ← [Environment]","CREATED_MR ← [AgentSession]","LAST_EDITED_BY ← [User]","MENTIONS ← [MergeRequest, WorkItem]","MERGED ← [User]","REOPENED ← [User]","REVIEWER ← [User]","UPDATED_BY ← [User]"
      - name: MergeRequestDiff
        props[15]: "id:int — Unique ID.","merge_request_id:int — Parent merge request ID.","state:string — Diff state: empty, without_files, collected, overflow. Deprecated values may still appear: timeout, overflow_commits_safe_size, overflow_diff_files_limit, overflow_diff_lines_limit.","base_commit_sha:string — Base commit SHA (common ancestor).","head_commit_sha:string — Head commit SHA (latest on source branch).","start_commit_sha:string — Start commit SHA (target branch tip at diff creation).","commits_count:int? — Number of commits.","files_count:int? — Number of files changed.","project_id:int — Owning project ID.","diff_type:enum — Source branch (regular) or merge-head state.","real_size:string — Non-truncated diff size from Gitaly, as a stringified integer.","stored_externally:bool — Whether diff content is in external object storage.","created_at:datetime? — Creation timestamp.","updated_at:datetime? — Last update timestamp.","patch:string? — Full unified patch. Resolved from GitLab at query time."
        out[2]: "HAS_FILE → [MergeRequestDiffFile]","IN_PROJECT → [Project]"
        in[2]: "HAS_DIFF ← [MergeRequest]","HAS_LATEST_DIFF ← [MergeRequest]"
      - name: MergeRequestDiffFile
        props[15]: "id:int — Synthetic identifier: sipHash64(merge_request_diff_id, relative_order).","merge_request_id:int — Parent merge request ID.","merge_request_diff_id:int — Parent merge request diff ID.","project_id:int — Owning project ID.","too_large:bool — Whether the diff is too large to display.","new_path:string — File path after the change. Differs from old_path only on renames.","old_path:string — File path before the change. Preferred for file lookups.","new_file:bool — Whether this is a newly added file.","renamed_file:bool — Whether this file was renamed.","deleted_file:bool — Whether this file was deleted.","binary:bool? — Whether this is a binary file.","generated:bool? — Whether auto-generated (e.g. lockfiles, minified bundles).","a_mode:string — Git mode bits before the change (e.g. 100644).","b_mode:string — Git mode bits after the change (e.g. 100755).","diff:string? — Per-file unified diff. Resolved from GitLab at query time. Null when too_large is true."
        out[1]: "IN_PROJECT → [Project]"
        in[1]: "HAS_FILE ← [MergeRequestDiff]"
  - name: container_registry
    nodes[1]:
      - name: ContainerRepository
        props[6]: "id:int — Unique ID.","name:string — Repository name (path within the project).","status:enum — Deletion lifecycle status. Empty string when the repository is active (no deletion scheduled).","created_at:datetime — Creation timestamp.","updated_at:datetime — Last update timestamp.","project_id:int — Owning project ID."
        out[1]: "IN_PROJECT → [Project]"
        in[0]:
  - name: core
    nodes[4]:
      - name: Group
        props[7]: "id:int — Unique ID.","full_path:string — Full path (e.g. gitlab-org/quality).","name:string — Display name.","description:string — Description text.","created_at:datetime? — Creation timestamp.","updated_at:datetime? — Last update timestamp.","visibility_level:enum — Visibility level."
        out[1]: "CONTAINS → [Group, Project]"
        in[4]: "CONTAINS ← [Group]","IN_GROUP ← [Label, Milestone, WorkItem]","MEMBER_OF ← [User]","OWNER ← [User]"
      - name: Note
        props[15]: "id:int — Unique ID.","note:string — Text content (markdown).","noteable_type:enum — Type of object the note is attached to.","noteable_id:int? — ID of the attached object. Null for commits.","line_code:string — Line position identifier for diff notes.","created_at:datetime? — Creation timestamp.","updated_at:datetime? — Last update timestamp.","discussion_id:string? — Discussion thread ID.","resolved_at:datetime? — Resolution timestamp.","internal:bool — Only visible to users with Reporter+ access on the parent resource.","confidential:bool? — Legacy alias for internal; synced on create. Being renamed per gitlab#367923.","commit_id:string — Commit SHA for commit notes.","st_diff:string — Serialized diff snippet for diff notes.","project_id:int? — Owning project ID.","author_id:int? — Author user ID."
        out[1]: "IN_PROJECT → [Project]"
        in[2]: "AUTHORED ← [User]","HAS_NOTE ← [MergeRequest, Vulnerability, WorkItem]"
      - name: Project
        props[10]: "id:int — Unique ID.","full_path:string — Full path (e.g. gitlab-org/gitlab).","name:string — Display name.","description:string — Description text.","created_at:datetime? — Creation timestamp.","updated_at:datetime? — Last update timestamp.","visibility_level:enum — Visibility level.","archived:bool — Archived flag.","star_count:int — Number of stars.","last_activity_at:datetime? — Last activity timestamp."
        out[1]: "CONTAINS → [Branch]"
        in[6]: "CONTAINS ← [Group, User]","CREATOR ← [User]","IN_PROJECT ← [AgentSession, Branch, ContainerRepository, Dependency, Deployment, Environment, Finding, Job, Label, MergeRequest, MergeRequestDiff, MergeRequestDiffFile, Milestone, Note, Package, PackageFile, Pipeline, SecurityScan, Stage, Vulnerability, VulnerabilityIdentifier, VulnerabilityOccurrence, VulnerabilityScanner, WorkItem]","MEMBER_OF ← [User]","SCANS ← [VulnerabilityScanner]","SOURCE_PROJECT ← [MergeRequest]"
      - name: User
        props[18]: "id:int — Unique ID.","username:string — Unique handle.","email:string — Primary email. Admins only until per-cell authz lands (gated by `read_user_email_address`).","name:string — Display name.","first_name:string — First name. Not on any public surface; admins only.","last_name:string — Last name. Not on any public surface; admins only.","created_at:datetime? — Creation timestamp.","updated_at:datetime? — Last update timestamp. Not on any public surface; admins only.","state:enum — Account state.","avatar_url:string? — Avatar upload filename (not a URL; the full URL is computed at runtime).","public_email:string — Public email, if set.","preferred_language:string — Preferred UI language. Self-only on REST; admins only until per-cell authz lands.","last_activity_on:date? — Last activity date.","private_profile:bool — Private profile flag. Self-only on REST; admins only here.","is_admin:bool — Instance administrator flag.","is_auditor:bool — Auditor role flag.","is_external:bool — External user flag. Self-only on REST, admin-only via UserWithAdmin; admins only here.","user_type:enum — Account type."
        out[18]: "APPROVED → [MergeRequest]","ASSIGNED → [MergeRequest, WorkItem]","AUTHORED → [MergeRequest, Note, Vulnerability, WorkItem]","CLOSED → [MergeRequest, WorkItem]","CONFIRMED_BY → [Vulnerability]","CONTAINS → [Project]","CREATOR → [Project]","DEPLOYED_BY → [Deployment]","DISMISSED_BY → [Vulnerability]","LAST_EDITED_BY → [MergeRequest]","MEMBER_OF → [Group, Project]","MERGED → [MergeRequest]","OWNER → [Group]","REOPENED → [MergeRequest, WorkItem]","RESOLVED_BY → [Vulnerability]","REVIEWER → [MergeRequest]","TRIGGERED → [Job, Pipeline]","UPDATED_BY → [MergeRequest]"
        in[0]:
  - name: packages
    nodes[3]:
      - name: Dependency
        props[4]: "id:int — Unique ID.","name:string — Dependency name.","version_pattern:string — Declared version pattern (for example, ^1.2.0).","project_id:int — Owning project ID."
        out[1]: "IN_PROJECT → [Project]"
        in[1]: "DECLARES_DEPENDENCY ← [Package]"
