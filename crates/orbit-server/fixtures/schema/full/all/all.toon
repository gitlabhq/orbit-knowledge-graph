        props[8]: "id:int — Unique ID.","name:string — Package name.","version:string? — Package version.","package_type:enum — Package format.","status:enum — Package lifecycle status.","created_at:datetime? — Creation timestamp.","updated_at:datetime? — Last update timestamp.","project_id:int — Owning project ID."
        out[5]: "BUILT_BY → [Pipeline]","DECLARES_DEPENDENCY → [Dependency]","HAS_PACKAGE_FILE → [PackageFile]","HAS_VULNERABILITY → [Vulnerability]","IN_PROJECT → [Project]"
        in[0]:
      - name: PackageFile
        props[9]: "id:int — Unique ID.","file_name:string — File name.","size:int? — File size in bytes.","file_sha256:string? — SHA-256 checksum of the file.","status:enum — File lifecycle status.","created_at:datetime? — Creation timestamp.","updated_at:datetime? — Last update timestamp.","project_id:int — Owning project ID.","package_id:int — Owning package ID."
        out[2]: "BUILT_BY → [Pipeline]","IN_PROJECT → [Project]"
        in[1]: "HAS_PACKAGE_FILE ← [Package]"
  - name: plan
    nodes[3]:
      - name: Label
        props[8]: "id:int — Unique ID.","title:string — Label title.","description:string — Description text.","color:string — Hex color code.","created_at:datetime? — Creation timestamp.","updated_at:datetime? — Last update timestamp.","project_id:int? — Owning project ID. Null for group-scoped.","group_id:int? — Owning group ID. Null for project-scoped."
        out[2]: "IN_GROUP → [Group]","IN_PROJECT → [Project]"
        in[1]: "HAS_LABEL ← [MergeRequest, WorkItem]"
      - name: Milestone
        props[11]: "id:int — Unique ID.","iid:int? — Scoped milestone number.","title:string — Title.","description:string — Description text.","state:string — State (active, closed).","due_date:date? — Due date.","start_date:date? — Start date.","created_at:datetime? — Creation timestamp.","updated_at:datetime? — Last update timestamp.","project_id:int? — Owning project ID. Null for group-scoped.","group_id:int? — Owning group ID. Null for project-scoped."
        out[2]: "IN_GROUP → [Group]","IN_PROJECT → [Project]"
        in[1]: "IN_MILESTONE ← [MergeRequest, WorkItem]"
      - name: WorkItem
        props[18]: "id:int — Unique ID.","iid:int — Scoped work item number.","title:string — Title.","description:string — Description body (markdown).","state:enum — Current state.","work_item_type:enum — Work item type.","confidential:bool — Confidential flag.","due_date:date? — Due date.","start_date:date? — Start date.","weight:int? — Weight/points assigned.","created_at:datetime? — Creation timestamp.","updated_at:datetime? — Last update timestamp.","closed_at:datetime? — Closed timestamp.","project_id:int? — Owning project ID. Null for group-scoped.","author_id:int? — Author user ID.","milestone_id:int? — Associated milestone ID.","namespace_id:int — Owning namespace (group) ID.","closed_by_id:int? — User ID who closed this."
        out[8]: "CONTAINS → [WorkItem]","HAS_LABEL → [Label]","HAS_NOTE → [Note]","IN_GROUP → [Group]","IN_MILESTONE → [Milestone]","IN_PROJECT → [Project]","MENTIONS → [MergeRequest, WorkItem]","RELATED_TO → [WorkItem]"
        in[8]: "ASSIGNED ← [User]","AUTHORED ← [User]","CLOSED ← [User]","CLOSES ← [MergeRequest]","CONTAINS ← [WorkItem]","MENTIONS ← [MergeRequest, WorkItem]","RELATED_TO ← [WorkItem]","REOPENED ← [User]"
  - name: security
    nodes[6]:
      - name: Finding
        props[11]: "id:int — Unique ID.","uuid:uuid — Unique UUID.","name:string — Finding name.","description:string — Detailed description.","solution:string — Recommended remediation.","severity:enum — Severity level.","deduplicated:bool — Deduplicated flag.","overridden_uuid:uuid — UUID of the overridden finding.","project_id:int — Owning project ID.","scan_id:int — Producing security scan ID.","scanner_id:int — Detecting scanner ID."
        out[3]: "DETECTED_BY → [VulnerabilityScanner]","HAS_IDENTIFIER → [VulnerabilityIdentifier]","IN_PROJECT → [Project]"
        in[1]: "HAS_FINDING ← [SecurityScan]"
      - name: SecurityScan
        props[9]: "id:int — Unique ID.","scan_type:enum — Scan type.","status:enum — Current status.","latest:bool — Whether this is the latest scan of its type for the project.","created_at:datetime — Creation timestamp.","updated_at:datetime — Last update timestamp.","project_id:int — Owning project ID.","pipeline_id:int? — Pipeline ID that ran this scan.","build_id:int — Job (build) ID that executed this scan."
        out[4]: "HAS_FINDING → [Finding]","IN_PIPELINE → [Pipeline]","IN_PROJECT → [Project]","RAN_BY → [Job]"
        in[0]:
      - name: Vulnerability
        props[20]: "id:int — Unique ID.","title:string — Summary title.","description:string — Detailed description.","state:enum — Current state.","severity:enum — Severity level.","report_type:enum — Security scan type that detected this.","resolved_on_default_branch:bool — Resolved on default branch.","present_on_default_branch:bool — Present on default branch.","created_at:datetime — Creation timestamp.","updated_at:datetime — Last update timestamp.","detected_at:datetime? — First detection timestamp.","resolved_at:datetime? — Resolution timestamp.","confirmed_at:datetime? — Confirmation timestamp.","dismissed_at:datetime? — Dismissal timestamp.","project_id:int — Owning project ID.","finding_id:int — Associated vulnerability occurrence ID.","author_id:int — Author user ID.","confirmed_by_id:int? — Confirming user ID.","resolved_by_id:int? — Resolving user ID.","dismissed_by_id:int? — Dismissing user ID."
        out[3]: "HAS_FINDING → [VulnerabilityOccurrence]","HAS_NOTE → [Note]","IN_PROJECT → [Project]"
        in[7]: "AUTHORED ← [User]","CONFIRMED_BY ← [User]","DISMISSED_BY ← [User]","FIXES ← [MergeRequest]","HAS_VULNERABILITY ← [Package]","OCCURRENCE_OF ← [VulnerabilityOccurrence]","RESOLVED_BY ← [User]"
      - name: VulnerabilityIdentifier
        props[8]: "id:int — Unique ID.","external_type:string — Identifier type (e.g. cve, cwe, gemnasium).","external_id:string — Identifier value (e.g. CVE-2021-44228).","name:string — Human-readable name.","url:string — Reference URL. May be empty for some identifier types.","created_at:datetime — Creation timestamp.","updated_at:datetime — Last update timestamp.","project_id:int — Owning project ID."
        out[1]: "IN_PROJECT → [Project]"
        in[1]: "HAS_IDENTIFIER ← [Finding, VulnerabilityOccurrence]"
      - name: VulnerabilityOccurrence
        props[18]: "id:int — Unique ID.","uuid:uuid — Unique UUID.","name:string — Occurrence name.","description:string — Detailed description.","solution:string — Recommended remediation.","cve:string — Legacy fingerprint for deduplication. Not necessarily a CVE ID despite the column name.","location:string — Vulnerability location (serialized JSON: file, dependency, image, or kubernetes_resource).","location_fingerprint:string — Location fingerprint.","severity:enum — Severity level.","report_type:enum — Security report type.","detection_method:enum — Detection method.","created_at:datetime — Creation timestamp.","updated_at:datetime — Last update timestamp.","detected_at:datetime? — Detection timestamp.","project_id:int — Owning project ID.","scanner_id:int — Detecting scanner ID.","vulnerability_id:int? — Linked vulnerability ID.","primary_identifier_id:int — Primary identifier (CVE/CWE) ID."
        out[4]: "DETECTED_BY → [VulnerabilityScanner]","HAS_IDENTIFIER → [VulnerabilityIdentifier]","IN_PROJECT → [Project]","OCCURRENCE_OF → [Vulnerability]"
        in[1]: "HAS_FINDING ← [Vulnerability]"
      - name: VulnerabilityScanner
        props[7]: "id:int — Unique ID.","external_id:string — External ID (e.g. gemnasium, bandit).","name:string — Display name.","vendor:string — Scanner vendor (default: GitLab).","created_at:datetime — Creation timestamp.","updated_at:datetime — Last update timestamp.","project_id:int — Owning project ID."
        out[2]: "IN_PROJECT → [Project]","SCANS → [Project]"
        in[1]: "DETECTED_BY ← [Finding, VulnerabilityOccurrence]"
  - name: source_code
    nodes[6]:
      - name: Branch
        props[4]: "id:int — Derived ID (hash of project_id + branch name).","project_id:int — Owning project ID.","name:string — Branch name (e.g., main, feature/new-login).","is_default:bool — Whether this is the project's default branch."
        out[2]: "CONTAINS → [Directory, File]","IN_PROJECT → [Project]"
        in[2]: "CONTAINS ← [Project]","ON_BRANCH ← [Directory, File]"
      - name: Commit
        props[3]: "id:int — Synthetic id: sipHash64(target_project_id, sha). Edges must derive target_id with the same formula.","sha:string — Clean hex commit SHA (40-char SHA-1 or 64-char SHA-256).","project_id:int — Owning project ID."
        out[0]:
        in[1]: "MERGED_AT_COMMIT ← [MergeRequest]"
      - name: Definition
