# Native-process Orbit dev environment against a Caproni cluster.
# Copy to .env and adjust. Ensure mise shell activation is enabled so that
# cargo and yq are on PATH.

# CAPRONI_DIR is the gitlab-caproni checkout whose cluster you develop against.
# The dev script runs `caproni kubectl` from that directory, so it always talks
# to the cluster that checkout owns. Default when unset: ~/gitlab-caproni.
CAPRONI_DIR=/path/to/your/gitlab-caproni

# Server settings (ports, consumer name, metrics) are not set here. Put personal
# overrides in config/dev.local.yaml; it is Git-ignored and merged last.
