{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContextRequest",
  "type": "object",
  "properties": {
    "targets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ContextTarget"
      },
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "targets"
  ],
  "$defs": {
    "ContextTarget": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "node": {
              "type": "string"
            },
            "id": {
              "type": "integer",
              "format": "int64",
              "minimum": 0,
              "maximum": 9223372036854775807
            }
          },
          "additionalProperties": false,
          "required": [
            "node",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "file": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "file"
          ]
        }
      ]
    }
  }
}
