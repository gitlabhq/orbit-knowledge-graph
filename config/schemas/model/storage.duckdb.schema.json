{
  "$defs": {
    "AccessHints": {
      "additionalProperties": false,
      "description": "How queries read an entity, in terms every backend turns into its own indexes and order.",
      "properties": {
        "filter": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "order": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "text": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Binding": {
      "additionalProperties": false,
      "description": "Where one relationship variant's rows live: a foreign key, an edge table, or both.",
      "properties": {
        "copies": {
          "additionalProperties": {
            "$ref": "#/$defs/OneOrMany"
          },
          "type": "object"
        },
        "edge_table": {
          "type": [
            "string",
            "null"
          ]
        },
        "fk": {
          "anyOf": [
            {
              "$ref": "#/$defs/KeySpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "index": {
          "anyOf": [
            {
              "$ref": "#/$defs/EdgeIndex"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "ColumnStorage": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "$ref": "#/$defs/DuckDbColumn"
        },
        "column": {
          "type": [
            "string",
            "null"
          ]
        },
        "immutable": {
          "default": false,
          "type": "boolean"
        },
        "selectivity": {
          "anyOf": [
            {
              "$ref": "#/$defs/FieldSelectivity"
            },
            {
              "type": "null"
            }
          ],
          "description": "How well an equality filter on the column narrows; without it the planner judges by type."
        },
        "stored_as_text": {
          "default": false,
          "description": "The column holds an enum's labels rather than its integer codes.",
          "type": "boolean"
        }
      },
      "required": [
        "backend"
      ],
      "type": "object"
    },
    "DuckDbColumn": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "DuckDbSource": {
      "additionalProperties": false,
      "properties": {
        "sort_key": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "EdgeColumns": {
      "additionalProperties": false,
      "description": "The column every edge table of a store keeps each edge field in.",
      "properties": {
        "relationship_kind": {
          "type": "string"
        },
        "source_id": {
          "type": "string"
        },
        "source_kind": {
          "type": "string"
        },
        "target_id": {
          "type": "string"
        },
        "target_kind": {
          "type": "string"
        }
      },
      "required": [
        "relationship_kind",
        "source_id",
        "source_kind",
        "target_id",
        "target_kind"
      ],
      "type": "object"
    },
    "EdgeIndex": {
      "additionalProperties": false,
      "description": "An edge table that the variant's writer derives from its foreign key, read in its place.",
      "properties": {
        "edge_table": {
          "type": "string"
        }
      },
      "required": [
        "edge_table"
      ],
      "type": "object"
    },
    "EdgeTableSpec": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "type": "object"
        },
        "shared": {
          "default": false,
          "type": "boolean"
        },
        "sort_key": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Endpoint": {
      "enum": [
        "source",
        "target"
      ],
      "type": "string"
    },
    "EngineSpec": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "$ref": "#/$defs/RelationalOptions"
        },
        "connection": {
          "type": "string"
        },
        "kind": {
          "const": "duckdb"
        },
        "path_column": {
          "type": [
            "string",
            "null"
          ]
        },
        "trusted": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "connection"
      ],
      "type": "object"
    },
    "EntityStorage": {
      "additionalProperties": false,
      "properties": {
        "accepts": {
          "description": "The stored properties a stage takes key sets on.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "access": {
          "$ref": "#/$defs/AccessHints"
        },
        "backend": {
          "$ref": "#/$defs/DuckDbSource"
        },
        "columns": {
          "additionalProperties": {
            "$ref": "#/$defs/ColumnStorage"
          },
          "type": "object"
        },
        "complete": {
          "default": false,
          "description": "This store holds or excludes every graph property of the entity, and plans read it here.",
          "type": "boolean"
        },
        "exclude": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "path_column": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "table": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "accepts",
        "table"
      ],
      "type": "object"
    },
    "FieldSelectivity": {
      "description": "Filter selectivity hint for the query planner.",
      "oneOf": [
        {
          "const": "low",
          "description": "Few distinct values (enums, booleans). Filtering narrows weakly.",
          "type": "string"
        },
        {
          "const": "high",
          "description": "Many distinct values (IDs, strings, timestamps). Filtering narrows effectively.",
          "type": "string"
        }
      ]
    },
    "KeySpec": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "$ref": "#/$defs/OneOrMany",
          "description": "One column, or one per part of a composite identity, in identity order."
        },
        "on": {
          "$ref": "#/$defs/Endpoint"
        },
        "type_column": {
          "type": [
            "string",
            "null"
          ]
        },
        "type_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/OneOrMany"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "on",
        "column"
      ],
      "type": "object"
    },
    "OneOrMany": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      ],
      "description": "One written value or a list of them."
    },
    "RelationalOptions": {
      "additionalProperties": false,
      "properties": {
        "deleted_column": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "edge_columns": {
          "anyOf": [
            {
              "$ref": "#/$defs/EdgeColumns"
            },
            {
              "type": "null"
            }
          ]
        },
        "edge_tables": {
          "additionalProperties": {
            "$ref": "#/$defs/EdgeTableSpec"
          },
          "type": "object"
        },
        "version_column": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "engine": {
      "anyOf": [
        {
          "$ref": "#/$defs/EngineSpec"
        },
        {
          "type": "null"
        }
      ]
    },
    "entities": {
      "additionalProperties": {
        "$ref": "#/$defs/EntityStorage"
      },
      "type": "object"
    },
    "kind": {
      "const": "storage",
      "type": "string"
    },
    "package": {
      "type": "string"
    },
    "relationships": {
      "additionalProperties": {
        "additionalProperties": {
          "$ref": "#/$defs/Binding"
        },
        "type": "object"
      },
      "type": "object"
    },
    "store": {
      "type": "string"
    }
  },
  "required": [
    "kind",
    "package",
    "store"
  ],
  "type": "object"
}
