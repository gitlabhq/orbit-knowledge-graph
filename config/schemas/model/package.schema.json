{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A package's manifest.",
  "properties": {
    "kind": {
      "const": "package",
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "requires": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "kind",
    "name"
  ],
  "type": "object"
}
