{
  "$defs": {
    "Binding": {
      "additionalProperties": false,
      "description": "Where one relationship variant's rows live: a foreign key, an edge table, or both.",
      "properties": {
        "copies": {
          "additionalProperties": {
            "$ref": "#/$defs/OneOrMany"
          },
          "type": "object"
        },
        "edge_table": {
          "type": [
            "string",
            "null"
          ]
        },
        "fk": {
          "anyOf": [
            {
              "$ref": "#/$defs/KeySpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "index": {
          "anyOf": [
            {
              "$ref": "#/$defs/EdgeIndex"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "CodeSource": {
      "additionalProperties": false,
      "properties": {
        "repository": {
          "additionalProperties": false,
          "description": "The columns that name the repository and the branch each row is in.",
          "properties": {
            "branch": {
              "type": "string"
            },
            "project": {
              "type": "string"
            }
          },
          "required": [
            "project",
            "branch"
          ],
          "type": "object"
        },
        "search": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/SearchMode"
            },
            "type": "array"
          },
          "type": "object"
        }
      },
      "required": [
        "repository"
      ],
      "type": "object"
    },
    "ColumnStorage": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "$ref": "#/$defs/NoOptions"
        },
        "column": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "EdgeIndex": {
      "additionalProperties": false,
      "description": "An edge table that the variant's writer derives from its foreign key, read in its place.",
      "properties": {
        "edge_table": {
          "type": "string"
        }
      },
      "required": [
        "edge_table"
      ],
      "type": "object"
    },
    "Endpoint": {
      "enum": [
        "source",
        "target"
      ],
      "type": "string"
    },
    "EngineSpec": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "$ref": "#/$defs/NoOptions"
        },
        "connection": {
          "type": "string"
        },
        "kind": {
          "const": "orbit_code"
        },
        "trusted": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "connection"
      ],
      "type": "object"
    },
    "EntityStorage": {
      "additionalProperties": false,
      "properties": {
        "accepts": {
          "description": "The stored properties a stage takes key sets on.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "backend": {
          "$ref": "#/$defs/CodeSource"
        },
        "columns": {
          "additionalProperties": {
            "$ref": "#/$defs/ColumnStorage"
          },
          "type": "object"
        },
        "complete": {
          "default": false,
          "description": "This store holds or excludes every graph property of the entity, and plans read it here.",
          "type": "boolean"
        },
        "exclude": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "accepts",
        "backend"
      ],
      "type": "object"
    },
    "KeySpec": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "$ref": "#/$defs/OneOrMany",
          "description": "One column, or one per part of a composite identity, in identity order."
        },
        "on": {
          "$ref": "#/$defs/Endpoint"
        },
        "type_column": {
          "type": [
            "string",
            "null"
          ]
        },
        "type_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/OneOrMany"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "on",
        "column"
      ],
      "type": "object"
    },
    "NoOptions": {
      "additionalProperties": false,
      "description": "The options of a backend block that takes none.",
      "type": "object"
    },
    "OneOrMany": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      ],
      "description": "One written value or a list of them."
    },
    "SearchMode": {
      "description": "A search a store's backend runs over a property.",
      "enum": [
        "trigram",
        "structural"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "engine": {
      "anyOf": [
        {
          "$ref": "#/$defs/EngineSpec"
        },
        {
          "type": "null"
        }
      ]
    },
    "entities": {
      "additionalProperties": {
        "$ref": "#/$defs/EntityStorage"
      },
      "type": "object"
    },
    "kind": {
      "const": "storage",
      "type": "string"
    },
    "package": {
      "type": "string"
    },
    "relationships": {
      "additionalProperties": {
        "additionalProperties": {
          "$ref": "#/$defs/Binding"
        },
        "type": "object"
      },
      "type": "object"
    },
    "store": {
      "type": "string"
    }
  },
  "required": [
    "kind",
    "package",
    "store"
  ],
  "type": "object"
}
