{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitlab.com/gitlab-org/orbit/knowledge-graph/schemas/graph_query/v13",
  "title": "GraphQueryAsJSON",
  "description": "Schema for LLM-generated graph queries that compile to ClickHouse SQL",
  "type": "object",
  "required": ["query_type", "nodes"],
  "properties": {
    "query_type": {
      "$ref": "#/$defs/QueryType"
    },
    "code_contexts": {
      "type": "array",
      "description": "Resolved source-code contexts. The PoC supports exactly one ready context.",
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/CodeContext"
      }
    },
    "nodes": {
      "type": "array",
      "description": "Node selectors for the query. Single-node queries use a 1-element array.",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/NodeSelector"
      }
    },
    "relationships": {
      "type": "array",
      "description": "Relationships between nodes to traverse",
      "default": [],
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/RelationshipSelector"
      }
    },
    "aggregations": {
      "type": "array",
      "description": "Aggregations to compute. Required when query_type is 'aggregation'.",
      "default": [],
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/Aggregation"
      }
    },
    "group_by": {
      "type": "array",
      "description": "Aggregation group keys.",
      "default": [],
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/GroupByKey"
      }
    },
    "path": {
      "$ref": "#/$defs/PathConfig",
      "description": "Path finding configuration. Required when query_type is 'path_finding'."
    },
    "neighbors": {
      "$ref": "#/$defs/NeighborsConfig",
      "description": "Neighbors configuration. Required when query_type is 'neighbors'."
    },
    "limit": {
      "type": "integer",
      "description": "Maximum number of results to return.",
      "minimum": 1,
      "maximum": 1000,
      "default": 30
    },
    "cursor": {
      "type": "object",
      "description": "Keyset pagination. First page: omit 'after'; stop when the response has no next_cursor. NULL sort keys sort last.",
      "required": ["page_size"],
      "properties": {
        "page_size": {
          "type": "integer",
          "description": "Max rows per page; a page may return fewer after redaction.",
          "minimum": 1,
          "maximum": 1000
        },
        "after": {
          "type": "string",
          "description": "pagination.next_cursor from the prior response. Changing the query invalidates it."
        }
      },
      "additionalProperties": false
    },
    "order_by": {
      "type": "string",
      "pattern": "^(?<descending>-)?(?<node>[a-zA-Z_][a-zA-Z0-9_]{0,63})\\.(?<property>[a-zA-Z_][a-zA-Z0-9_]{0,63})$",
      "description": "Result ordering as \"node.property\" (ascending) or \"-node.property\" (descending)."
    },
    "aggregation_sort": {
      "type": "string",
      "pattern": "^(?<descending>-)?(?<column>[a-zA-Z_][a-zA-Z0-9_]{0,63})$",
      "description": "Aggregation row ordering as an output column name (aggregation alias or group-key column): \"column\" (ascending) or \"-column\" (descending)."
    },
    "options": {
      "$ref": "#/$defs/QueryOptions",
      "description": "Presentation options."
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "query_type": { "const": "neighbors" }
        }
      },
      "then": {
        "required": ["neighbors"],
        "properties": {
          "nodes": {
            "maxItems": 1,
            "description": "Neighbors queries take exactly 1 node: the center"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "query_type": { "const": "aggregation" }
        }
      },
      "then": {
        "required": ["aggregations"],
        "properties": {
          "aggregations": {
            "minItems": 1
          },
          "nodes": {
            "minItems": 1,
            "description": "Aggregation requires at least 1 node"
          },
          "relationships": {
            "items": {
              "properties": {
                "direction": {
                  "enum": ["outgoing", "incoming"],
                  "description": "Aggregation only supports outgoing or incoming direction."
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "required": ["nodes"],
              "properties": {
                "nodes": {
                  "minItems": 2
                },
                "relationships": {
                  "maxItems": 0
                }
              }
            },
            "then": {
              "required": ["group_by"],
              "properties": {
                "group_by": {
                  "minItems": 1,
                  "description": "Required for disconnected multi-node aggregation; otherwise add relationships."
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "not": {
          "properties": {
            "query_type": { "const": "aggregation" }
          }
        }
      },
      "then": {
        "description": "Only aggregation queries may group results.",
        "not": { "required": ["group_by"] }
      }
    },
    {
      "if": {
        "properties": {
          "query_type": { "const": "traversal" }
        }
      },
      "then": {
        "description": "Multi-node traversal requires nodes + relationships. Single-node traversal requires exactly 1 node and no relationships.",
        "oneOf": [
          {
            "required": ["relationships"],
            "properties": {
              "nodes": {
                "minItems": 2,
                "description": "Multi-node traversal requires at least 2 nodes"
              },
              "relationships": {
                "minItems": 1,
                "description": "Multi-node traversal requires at least 1 relationship"
              }
            }
          },
          {
            "not": { "required": ["relationships"] },
            "properties": {
              "nodes": {
                "maxItems": 1
              }
            },
            "description": "Single-node traversal (table scan)"
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "query_type": { "const": "path_finding" }
        }
      },
      "then": {
        "required": ["path"],
        "properties": {
          "nodes": {
            "minItems": 2,
            "description": "Path finding requires at least 2 nodes (start and end)"
          }
        }
      }
    }
  ],
  "$defs": {
    "Identifier": {
      "type": "string",
      "description": "Safe SQL identifier: starts with letter/underscore, alphanumeric/underscore only, max 64 chars",
      "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,63}$",
      "minLength": 1,
      "maxLength": 64
    },
    "QueryType": {
      "type": "string",
      "description": "Type of graph query to execute",
      "enum": ["traversal", "aggregation", "path_finding", "neighbors"]
    },
    "CodeContext": {
      "type": "object",
      "description": "A resolved, immutable source-code overlay generation.",
      "required": ["project_id", "ref", "base_ref", "indexed_sha", "base_sha", "generation", "state"],
      "properties": {
        "project_id": { "type": "integer" },
        "ref": { "type": "string", "minLength": 1 },
        "commit_sha": { "type": "string", "minLength": 1 },
        "base_ref": { "type": "string", "minLength": 1 },
        "indexed_sha": { "type": "string", "minLength": 1 },
        "base_sha": { "type": "string", "minLength": 1 },
        "generation": { "type": "integer", "minimum": 0 },
        "state": {
          "type": "string",
          "enum": ["building", "ready", "stale", "failed", "missing"]
        }
      },
      "additionalProperties": false
    },
    "EntityType": {
      "type": "string",
      "description": "Valid entity types corresponding to GitLab data types (e.g., User, Project, MergeRequest). Validated against ontology at runtime.",
      "minLength": 1
    },
    "NodeProperties": {
      "type": "object",
      "description": "Property definitions per node label. Populated dynamically from ontology. Keys are entity names, values describe available properties.",
      "additionalProperties": {
        "type": "object",
        "description": "Properties available for a specific node label. Keys are property names, values are property schemas.",
        "additionalProperties": {
          "type": "object",
          "description": "Schema for a single property",
          "properties": {
            "type": {
              "type": "string",
              "description": "JSON Schema type of the property",
              "enum": ["string", "integer", "number", "boolean", "array", "object", "null"]
            },
            "description": {
              "type": "string",
              "description": "Human-readable description of the property"
            },
            "format": {
              "type": "string",
              "description": "Optional format hint (e.g., 'date-time', 'email', 'uri')"
            },
            "items": {
              "type": "object",
              "description": "For array types, describes the items"
            }
          }
        }
      }
    },
    "NodeSelector": {
      "type": "object",
      "description": "Selector for matching nodes in the graph",
      "required": ["id", "entity"],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier",
          "description": "Variable id referenced by relationships and aggregations (e.g. 'mr')."
        },
        "entity": {
          "$ref": "#/$defs/EntityType",
          "description": "Entity type (e.g. User, Project, MergeRequest)."
        },
        "columns": {
          "$ref": "#/$defs/ColumnSelection",
          "description": "'*' for all columns, an array of names, or omitted for the ontology default_columns. id and type are always included."
        },
        "filters": {
          "type": "object",
          "description": "Property filters keyed by property name.",
          "propertyNames": {
            "$ref": "#/$defs/Identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/FilterEntry"
          },
          "maxProperties": 10,
          "default": {}
        },
        "node_ids": {
          "type": "array",
          "description": "Specific node IDs to filter by. Accepts integers or digit strings.",
          "items": {
            "oneOf": [
              { "type": "integer" },
              { "type": "string", "pattern": "^-?[0-9]+$", "maxLength": 20 }
            ]
          },
          "minItems": 1,
          "maxItems": 500
        },
        "id_range": {
          "$ref": "#/$defs/IdRange",
          "description": "ID range filter (inclusive)"
        },
        "id_property": {
          "$ref": "#/$defs/Identifier",
          "description": "Which property to use as ID (default: 'id')",
          "default": "id"
        }
      },
      "additionalProperties": false
    },
    "ColumnSelection": {
      "description": "Column selection for a node. Use '*' for all columns or an array of specific column names.",
      "oneOf": [
        {
          "const": "*",
          "description": "Select all columns for this entity"
        },
        {
          "type": "array",
          "description": "List of specific column names to select",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "minItems": 1,
          "maxItems": 50
        }
      ]
    },
    "IdRange": {
      "type": "object",
      "description": "Inclusive ID range filter. Endpoints accept integers or digit strings.",
      "required": ["start", "end"],
      "properties": {
        "start": {
          "description": "Start of ID range (inclusive)",
          "oneOf": [
            { "type": "integer" },
            { "type": "string", "pattern": "^-?[0-9]+$", "maxLength": 20 }
          ]
        },
        "end": {
          "description": "End of ID range (inclusive)",
          "oneOf": [
            { "type": "integer" },
            { "type": "string", "pattern": "^-?[0-9]+$", "maxLength": 20 }
          ]
        }
      },
      "additionalProperties": false
    },
    "FilterEntry": {
      "description": "A bare value is an equality match; otherwise one or more operator objects (array only to repeat an operator).",
      "oneOf": [
        {
          "$ref": "#/$defs/FilterValue",
          "description": "Equality match"
        },
        {
          "$ref": "#/$defs/OperatorFilter"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OperatorFilter"
          },
          "minItems": 1,
          "maxItems": 10
        }
      ]
    },
    "OperatorFilter": {
      "type": "object",
      "description": "Operator-keyed filter; multiple keys AND-combine, e.g. {\"gte\": a, \"lt\": b}.",
      "minProperties": 1,
      "properties": {
        "eq": { "$ref": "#/$defs/FilterValue" },
        "gt": { "$ref": "#/$defs/FilterValue" },
        "lt": { "$ref": "#/$defs/FilterValue" },
        "gte": { "$ref": "#/$defs/FilterValue" },
        "lte": { "$ref": "#/$defs/FilterValue" },
        "in": {
          "type": "array",
          "description": "Set membership.",
          "items": { "$ref": "#/$defs/FilterValue" },
          "minItems": 1,
          "maxItems": 100
        },
        "contains": { "$ref": "#/$defs/SearchPattern" },
        "starts_with": { "$ref": "#/$defs/SearchPattern" },
        "ends_with": { "$ref": "#/$defs/SearchPattern" },
        "is_null": {
          "type": "boolean",
          "description": "true matches NULL; false matches non-NULL."
        },
        "is_not_null": {
          "type": "boolean",
          "description": "true matches non-NULL; false matches NULL."
        },
        "token_match": {
          "$ref": "#/$defs/SearchPattern",
          "description": "Exact word match. Only on fields that support word matching."
        },
        "all_tokens": {
          "$ref": "#/$defs/SearchPattern",
          "description": "All words present. Only on fields that support word matching."
        },
        "any_tokens": {
          "$ref": "#/$defs/SearchPattern",
          "description": "Any word present. Only on fields that support word matching."
        }
      },
      "additionalProperties": false
    },
    "FilterValue": {
      "description": "A filter value - can be a number (integer or float), string, boolean, or list",
      "oneOf": [
        {
          "type": "number",
          "description": "Numeric value (integer or floating-point)"
        },
        {
          "type": "string",
          "description": "String value",
          "maxLength": 1024
        },
        {
          "type": "boolean",
          "description": "Boolean value"
        },
        {
          "type": "array",
          "description": "List of values",
          "items": {
            "$ref": "#/$defs/FilterValue"
          },
          "maxItems": 100
        }
      ]
    },
    "SearchPattern": {
      "type": "string",
      "description": "Substring or word-match pattern. Patterns shorter than 3 characters are rejected at compile time (traversal_path exempt).",
      "maxLength": 1024
    },
    "RelationshipSelector": {
      "type": "object",
      "description": "Selector for relationship traversal between nodes",
      "required": ["type", "from", "to"],
      "properties": {
        "type": {
          "$ref": "#/$defs/RelationshipType",
          "description": "Relationship type(s) to traverse"
        },
        "from": {
          "$ref": "#/$defs/Identifier",
          "description": "Source node variable ID (must match a node's id field)"
        },
        "to": {
          "$ref": "#/$defs/Identifier",
          "description": "Target node variable ID (must match a node's id field)"
        },
        "hops": {
          "type": "array",
          "description": "Inclusive [min, max] hop range; [2, 2] means exactly 2 hops.",
          "default": [1, 1],
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "minItems": 2,
          "maxItems": 2
        },
        "direction": {
          "$ref": "#/$defs/Direction",
          "description": "Direction to traverse the relationship",
          "default": "outgoing"
        },
        "filters": {
          "type": "object",
          "description": "Filters on relationship properties. Limited to prevent query complexity explosion.",
          "propertyNames": {
            "$ref": "#/$defs/Identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/FilterEntry"
          },
          "maxProperties": 5,
          "default": {}
        }
      },
      "additionalProperties": false
    },
    "RelationshipType": {
      "description": "Relationship type specification - single, multiple, or wildcard",
      "oneOf": [
        {
          "$ref": "#/$defs/RelationshipTypeName",
          "description": "Single relationship type"
        },
        {
          "type": "array",
          "description": "Multiple relationship types (UNION ALL)",
          "items": {
            "$ref": "#/$defs/RelationshipTypeName"
          },
          "minItems": 1,
          "maxItems": 10
        }
      ]
    },
    "RelationshipTypeName": {
      "type": "string",
      "description": "Valid relationship type names. Validated against ontology at runtime.",
      "minLength": 1
    },
    "Direction": {
      "type": "string",
      "description": "Direction to traverse relationships. 'outgoing' follows from_table → to_table, 'incoming' reverses it.",
      "enum": ["outgoing", "incoming", "both"],
      "default": "outgoing"
    },
    "NodeOrPropertyRef": {
      "type": "string",
      "description": "Reference to a node (\"mr\") or a scalar property (\"mr.merge_duration\").",
      "pattern": "^(?<node>[a-zA-Z_][a-zA-Z0-9_]{0,63})(\\.(?<property>[a-zA-Z_][a-zA-Z0-9_]{0,63}))?$"
    },
    "NodePropertyRef": {
      "type": "string",
      "description": "Reference to a scalar property as \"node.property\".",
      "pattern": "^(?<node>[a-zA-Z_][a-zA-Z0-9_]{0,63})\\.(?<property>[a-zA-Z_][a-zA-Z0-9_]{0,63})$"
    },
    "Aggregation": {
      "type": "object",
      "description": "Single function key, e.g. {\"avg\": \"mr.merge_duration\", \"as\": \"avg_dur\"}. Output column: \"as\", else function_node or function_node_property.",
      "properties": {
        "count": {
          "$ref": "#/$defs/NodeOrPropertyRef",
          "description": "Count rows where the node matched (\"mr\") or non-null values of a property (\"mr.merged_at\")."
        },
        "sum": { "$ref": "#/$defs/NodePropertyRef" },
        "avg": { "$ref": "#/$defs/NodePropertyRef" },
        "min": { "$ref": "#/$defs/NodePropertyRef" },
        "max": { "$ref": "#/$defs/NodePropertyRef" },
        "collect": { "$ref": "#/$defs/NodePropertyRef" },
        "as": {
          "$ref": "#/$defs/Identifier",
          "description": "Custom output column name; referenced by aggregation_sort."
        }
      },
      "oneOf": [
        { "required": ["count"] },
        { "required": ["sum"] },
        { "required": ["avg"] },
        { "required": ["min"] },
        { "required": ["max"] },
        { "required": ["collect"] }
      ],
      "maxProperties": 2,
      "additionalProperties": false
    },
    "GroupByKey": {
      "description": "\"node\" buckets by entity, \"node.property\" by scalar value. Output column: \"as\" when given, else node id or node_property (_unit suffix when truncated).",
      "oneOf": [
        {
          "$ref": "#/$defs/NodeOrPropertyRef"
        },
        {
          "type": "object",
          "description": "Truncation and/or output name: {\"key\": \"mr.created_at\", \"truncate\": \"month\", \"as\": \"month\"}. truncate needs a Date/DateTime property; minute/hour also need node_ids or a filter on it.",
          "required": ["key"],
          "anyOf": [{ "required": ["truncate"] }, { "required": ["as"] }],
          "properties": {
            "key": {
              "$ref": "#/$defs/NodeOrPropertyRef"
            },
            "truncate": {
              "enum": ["minute", "hour", "day", "week", "month", "quarter", "year"]
            },
            "as": {
              "$ref": "#/$defs/Identifier"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "PathConfig": {
      "type": "object",
      "description": "Configuration for path finding queries",
      "required": ["type", "from", "to", "max_depth"],
      "properties": {
        "type": {
          "$ref": "#/$defs/PathType",
          "description": "Type of path finding algorithm"
        },
        "from": {
          "$ref": "#/$defs/Identifier",
          "description": "Source node variable ID"
        },
        "to": {
          "$ref": "#/$defs/Identifier",
          "description": "Target node variable ID"
        },
        "max_depth": {
          "type": "integer",
          "description": "Maximum path length (number of hops). SECURITY: Maximum 3 enforced.",
          "minimum": 1,
          "maximum": 3
        },
        "rel_types": {
          "type": "array",
          "description": "Relationship types to traverse. Required when an endpoint is constrained by filters or id_range; optional when both endpoints use node_ids.",
          "items": {
            "$ref": "#/$defs/RelationshipTypeName"
          },
          "maxItems": 10
        }
      },
      "additionalProperties": false
    },
    "PathType": {
      "type": "string",
      "description": "Path finding algorithm type",
      "enum": ["shortest"]
    },
    "NeighborsConfig": {
      "type": "object",
      "description": "Configuration for neighbors queries. The center is the query's single node.",
      "properties": {
        "direction": {
          "$ref": "#/$defs/Direction",
          "description": "Traversal direction (default: both).",
          "default": "both"
        },
        "rel_types": {
          "type": "array",
          "description": "Relationship types to traverse; omitted = all.",
          "items": {
            "$ref": "#/$defs/RelationshipTypeName"
          },
          "maxItems": 10,
          "default": []
        }
      },
      "additionalProperties": false
    },
    "QueryOptions": {
      "type": "object",
      "description": "Presentation hints; never affect query semantics. Unrecognized fields are ignored.",
      "properties": {
        "dynamic_columns": {
          "$ref": "#/$defs/DynamicColumnMode",
          "description": "Columns for dynamically-discovered entities (path_finding, neighbors hydration): '*' = all, 'default' = ontology default_columns (the default).",
          "default": "default"
        },
        "include_debug_sql": {
          "type": "boolean",
          "description": "Include compiled SQL in response metadata. Honored only for GitLab team members (SaaS) or instance admins (self-managed/Dedicated).",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "DynamicColumnMode": {
      "type": "string",
      "description": "Controls column selection for dynamically-discovered entities during hydration.",
      "enum": ["*", "default"],
      "default": "default"
    }
  }
}
