WITH
  _batch AS (SELECT
    id,
    user_id,
    awardable_type,
    awardable_id,
    traversal_path,
    {{version_column}} AS _version,
    {{deleted_column}} AS _deleted
  FROM siphon_award_emoji {{final}}
  WHERE startsWith(traversal_path, {traversal_path:String}) {{filters}}
  ORDER BY traversal_path, awardable_type, awardable_id, id
  LIMIT {{batch_size}}),
  _prev AS (SELECT
    id,
    argMax(user_id, {{version_column}}) AS prev_user_id
  FROM siphon_award_emoji
  WHERE (traversal_path, awardable_type, awardable_id, id) IN (SELECT traversal_path, awardable_type, awardable_id, id FROM _batch WHERE _deleted)
    AND {{deleted_column}} = false
  GROUP BY id)
SELECT
  _batch.traversal_path AS traversal_path,
  _batch.id AS id,
  _batch.awardable_type AS awardable_type,
  _batch.awardable_id AS awardable_id,
  nullIf(if(_batch._deleted, _prev.prev_user_id, _batch.user_id), 0) AS user_id,
  _batch._version AS _version,
  _batch._deleted AS _deleted
FROM _batch
LEFT JOIN _prev ON _prev.id = _batch.id
ORDER BY traversal_path, awardable_type, awardable_id, id
