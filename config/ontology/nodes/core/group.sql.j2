-- The watermark and version of a Group row are the newest of its namespace,
-- namespace_details and route rows, so a change to any of the three re-extracts
-- the group. A group that is scheduled for deletion (state 2) or being deleted
-- (state 4) is emitted as a tombstone.
SELECT
  namespace.id AS id,
  namespace.name AS name,
  namespace.description AS description,
  namespace.visibility_level AS visibility_level,
  namespace.full_path AS full_path,
  namespace.parent_id AS parent_id,
  namespace.owner_id AS owner_id,
  namespace.created_at AS created_at,
  namespace.updated_at AS updated_at,
  namespace.traversal_path AS traversal_path,
  namespace.{{version_column}} AS _version,
  (namespace.{{deleted_column}} OR namespace.type != 'Group' OR namespace.state = 2 OR namespace.state = 4) AS _deleted
FROM (
  SELECT
    ns.id AS id,
    ns.name AS name,
    ifNull(details.description, '') AS description,
    ns.visibility_level AS visibility_level,
    ifNull(routes.route_path, ns.path) AS full_path,
    ns.parent_id AS parent_id,
    ns.owner_id AS owner_id,
    ns.created_at AS created_at,
    ns.updated_at AS updated_at,
    ns.type AS type,
    ns.state AS state,
    traversal_paths.current_path AS traversal_path,
    greatest(ns.{{version_column}}, ifNull(details.details_version, ns.{{version_column}}), ifNull(routes.route_version, ns.{{version_column}})) AS {{version_column}},
    greatest(ns.{{watermark_column}}, ifNull(details.details_watermark, ns.{{watermark_column}}), ifNull(routes.route_watermark, ns.{{watermark_column}})) AS {{watermark_column}},
    ns.{{deleted_column}} AS {{deleted_column}}
  FROM (
    SELECT
      *
    FROM siphon_namespaces
    WHERE id IN (SELECT
        id
      FROM namespace_traversal_paths
      WHERE startsWith(traversal_path, {traversal_path:String}))
    ORDER BY id, {{version_column}} DESC
    LIMIT 1 BY id ) ns
  INNER JOIN (
    SELECT
      id,
      argMax(traversal_path, version) AS current_path
    FROM namespace_traversal_paths
    WHERE startsWith(traversal_path, {traversal_path:String})
    GROUP BY id ) traversal_paths ON ns.id = traversal_paths.id
  LEFT JOIN (
    SELECT
      namespace_id,
      if(argMax({{deleted_column}}, {{version_column}}), NULL, argMax(description, {{version_column}})) AS description,
      toNullable(max({{version_column}})) AS details_version,
      toNullable(max({{watermark_column}})) AS details_watermark
    FROM siphon_namespace_details
    WHERE startsWith(traversal_path, {traversal_path:String})
    GROUP BY namespace_id ) details ON ns.id = details.namespace_id
  LEFT JOIN (
    SELECT
      source_id,
      if(argMax({{deleted_column}}, {{version_column}}), NULL, toNullable(argMax(path, {{version_column}}))) AS route_path,
      toNullable(max({{version_column}})) AS route_version,
      toNullable(max({{watermark_column}})) AS route_watermark
    FROM siphon_routes
    WHERE startsWith(traversal_path, {traversal_path:String})
      AND source_type = 'Namespace'
    GROUP BY source_id ) routes ON ns.id = routes.source_id
  WHERE startsWith(traversal_paths.current_path, {traversal_path:String}) ) namespace
WHERE 1=1 {{filters}}
ORDER BY traversal_path, id
LIMIT {{batch_size}}
