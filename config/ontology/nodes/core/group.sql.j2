-- Route and details rows can land after the namespace row, as after a transfer.
-- The late branch re-extracts those ids. A full load reads every row, so it skips the branch.
-- State 2 is deletion_scheduled and state 4 is deletion_in_progress.
WITH late AS (
  SELECT id, max({{version_column}}) AS late_version, max({{watermark_column}}) AS late_watermark
  FROM (
    SELECT namespace_id AS id, {{version_column}}, {{watermark_column}}
    FROM siphon_namespace_details
    WHERE startsWith(traversal_path, {traversal_path:String})
      AND {{watermark_column}} > {last_watermark:String} AND {{watermark_column}} <= {watermark:String}
    UNION ALL
    SELECT source_id AS id, {{version_column}}, {{watermark_column}}
    FROM siphon_routes
    WHERE startsWith(traversal_path, {traversal_path:String}) AND source_type = 'Namespace'
      AND {{watermark_column}} > {last_watermark:String} AND {{watermark_column}} <= {watermark:String} )
  WHERE {last_watermark:String} > '1970-01-01 00:00:00.000000'
  GROUP BY id
)
SELECT
  namespace.id AS id,
  namespace.name AS name,
  ifNull(details.description, '') AS description,
  namespace.visibility_level AS visibility_level,
  if(isNotNull(routes.source_id), routes.path, namespace.path) AS full_path,
  namespace.parent_id AS parent_id,
  namespace.owner_id AS owner_id,
  namespace.created_at AS created_at,
  namespace.updated_at AS updated_at,
  traversal_paths.current_path AS traversal_path,
  namespace.{{version_column}} AS _version,
  (namespace.{{deleted_column}} OR namespace.type != 'Group' OR namespace.state = 2 OR namespace.state = 4) AS _deleted
FROM (
  SELECT id, name, path, visibility_level, parent_id, owner_id, created_at, updated_at, type, state,
    {{version_column}}, {{watermark_column}}, {{deleted_column}}
  FROM siphon_namespaces
  UNION ALL
  SELECT ns.id, ns.name, ns.path, ns.visibility_level, ns.parent_id, ns.owner_id, ns.created_at, ns.updated_at, ns.type, ns.state,
    greatest(ns.{{version_column}}, late.late_version), late.late_watermark, ns.{{deleted_column}}
  FROM (
    SELECT * FROM siphon_namespaces
    WHERE id IN (SELECT id FROM late)
    ORDER BY id, {{version_column}} DESC
    LIMIT 1 BY id ) ns
  INNER JOIN late ON ns.id = late.id ) namespace
INNER JOIN (
  SELECT
    id,
    argMax(traversal_path, version) AS current_path
  FROM namespace_traversal_paths
  WHERE startsWith(traversal_path, {traversal_path:String})
  GROUP BY id ) traversal_paths ON namespace.id = traversal_paths.id
LEFT JOIN (
  SELECT
    namespace_id,
    argMax(description, {{version_column}}) AS description
  FROM siphon_namespace_details
  WHERE startsWith(traversal_path, {traversal_path:String})
  GROUP BY namespace_id
  HAVING argMax({{deleted_column}}, {{version_column}}) = false ) details ON namespace.id = details.namespace_id
LEFT JOIN (
  SELECT
    toNullable(source_id) AS source_id,
    argMax(path, {{version_column}}) AS path
  FROM siphon_routes
  WHERE startsWith(traversal_path, {traversal_path:String})
    AND source_type = 'Namespace'
  GROUP BY source_id
  HAVING argMax({{deleted_column}}, {{version_column}}) = false ) routes ON namespace.id = routes.source_id
WHERE startsWith(traversal_paths.current_path, {traversal_path:String})
  AND (namespace.id IN (SELECT
      id
    FROM namespace_traversal_paths
    WHERE startsWith(traversal_path, {traversal_path:String}))) {{filters}}
ORDER BY traversal_path, id
LIMIT {{batch_size}}
