-- Route rows can land after the project row, as after a transfer.
-- The late branch re-extracts those ids. A full load reads every row, so it skips the branch.
WITH late AS (
  SELECT source_id AS id, max({{version_column}}) AS late_version, max({{watermark_column}}) AS late_watermark
  FROM siphon_routes
  WHERE startsWith(traversal_path, {traversal_path:String}) AND source_type = 'Project'
    AND {{watermark_column}} > {last_watermark:String} AND {{watermark_column}} <= {watermark:String}
    AND {last_watermark:String} > '1970-01-01 00:00:00.000000'
  GROUP BY source_id
)
SELECT
  project.id AS id,
  project.name AS name,
  project.description AS description,
  project.visibility_level AS visibility_level,
  if(isNotNull(route.source_id), route.path, project.path) AS full_path,
  project.namespace_id AS namespace_id,
  project.creator_id AS creator_id,
  project.created_at AS created_at,
  project.updated_at AS updated_at,
  project.archived AS archived,
  project.star_count AS star_count,
  project.last_activity_at AS last_activity_at,
  traversal_paths.current_path AS traversal_path,
  project.{{version_column}} AS _version,
  project.{{deleted_column}} AS _deleted
FROM (
  SELECT id, name, path, description, visibility_level, namespace_id, creator_id, created_at, updated_at,
    archived, star_count, last_activity_at, {{version_column}}, {{watermark_column}}, {{deleted_column}}
  FROM siphon_projects
  UNION ALL
  SELECT p.id, p.name, p.path, p.description, p.visibility_level, p.namespace_id, p.creator_id, p.created_at, p.updated_at,
    p.archived, p.star_count, p.last_activity_at,
    greatest(p.{{version_column}}, late.late_version), late.late_watermark, p.{{deleted_column}}
  FROM (
    SELECT * FROM siphon_projects
    WHERE id IN (SELECT id FROM late)
    ORDER BY id, {{version_column}} DESC
    LIMIT 1 BY id ) p
  INNER JOIN late ON p.id = late.id ) project
INNER JOIN (
  SELECT
    id,
    argMax(traversal_path, version) AS current_path
  FROM project_namespace_traversal_paths
  WHERE startsWith(traversal_path, {traversal_path:String})
  GROUP BY id ) traversal_paths ON project.id = traversal_paths.id
LEFT JOIN (
  SELECT
    toNullable(source_id) AS source_id,
    argMax(path, {{version_column}}) AS path
  FROM siphon_routes
  WHERE startsWith(traversal_path, {traversal_path:String})
    AND source_type = 'Project'
  GROUP BY source_id
  HAVING argMax({{deleted_column}}, {{version_column}}) = false ) route ON project.id = route.source_id
WHERE startsWith(traversal_paths.current_path, {traversal_path:String})
  AND (project.id IN (SELECT
      id
    FROM project_namespace_traversal_paths
    WHERE startsWith(traversal_path, {traversal_path:String}))) {{filters}}
ORDER BY traversal_path, id
LIMIT {{batch_size}}
