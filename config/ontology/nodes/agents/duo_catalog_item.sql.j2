WITH _paths AS (SELECT
    id,
    dictGetOrDefault('project_traversal_paths_dict', 'traversal_path', toUInt64(argMaxIf(project_id, {{version_column}}, NOT {{deleted_column}} AND isNotNull(project_id))), '0/') AS project_path
  FROM siphon_ai_catalog_items
  GROUP BY id)
SELECT
  i.id AS id,
  i.name AS name,
  i.description AS description,
  i.item_type AS item_type,
  i.visibility AS visibility,
  i.verification_level AS verification_level,
  i.project_id AS project_id,
  i.star_count AS star_count,
  i.last_30_day_usage_count AS last_30_day_usage_count,
  i.created_at AS created_at,
  i.updated_at AS updated_at,
  p.project_path AS traversal_path,
  i.{{version_column}} AS _version,
  (i.{{deleted_column}} OR i.deleted_at IS NOT NULL) AS _deleted
FROM siphon_ai_catalog_items AS i {{final}}
INNER JOIN _paths AS p ON p.id = i.id
WHERE startsWith(p.project_path, {traversal_path:String}) {{filters}}
ORDER BY traversal_path, id
LIMIT {{batch_size}}
