WITH page AS (
  SELECT
    id,
    iid,
    sha,
    ref,
    status,
    source,
    tag,
    duration,
    failure_reason,
    created_at,
    started_at,
    finished_at,
    committed_at,
    updated_at,
    before_sha,
    yaml_errors,
    protected,
    project_id,
    user_id,
    merge_request_id,
    auto_canceled_by_id,
    traversal_path,
    partition_id,
    {{version_column}} AS _version,
    {{deleted_column}} AS _deleted
  FROM siphon_p_ci_pipelines
  WHERE startsWith(traversal_path, {traversal_path:String}) {{filters}}
  ORDER BY traversal_path, id, partition_id
  LIMIT {{batch_size}} )
SELECT
  page.*,
  coalesce(metadata.name, '') AS name
FROM page
LEFT JOIN (
  SELECT
    traversal_path AS metadata_traversal_path,
    pipeline_id AS metadata_pipeline_id,
    argMax(name, {{version_column}}) AS name,
    argMax({{deleted_column}}, {{version_column}}) AS deleted
  FROM siphon_ci_pipeline_metadata
  WHERE startsWith(traversal_path, {traversal_path:String})
    AND (traversal_path, pipeline_id) IN (SELECT traversal_path, id FROM page)
  GROUP BY traversal_path, pipeline_id
  HAVING deleted = false ) AS metadata
  ON page.traversal_path = metadata.metadata_traversal_path
  AND page.id = metadata.metadata_pipeline_id
ORDER BY page.traversal_path, page.id, page.partition_id
