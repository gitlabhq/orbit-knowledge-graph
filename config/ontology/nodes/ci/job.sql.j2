SELECT
  id,
  name,
  status,
  ref,
  tag,
  allow_failure,
  coverage,
  environment,
  when,
  retried,
  failure_reason,
  created_at,
  started_at,
  finished_at,
  queued_at,
  intDiv(
    toUnixTimestamp64Micro(finished_at) - toUnixTimestamp64Micro(started_at),
    1000000
  ) AS duration,
  intDiv(
    toUnixTimestamp64Micro(coalesce(started_at, finished_at)) - toUnixTimestamp64Micro(queued_at),
    1000000
  ) AS queued_duration,
  type,
  runner_id,
  timeout,
  timeout_source,
  exit_code,
  scheduling_type,
  project_id,
  user_id,
  upstream_pipeline_id,
  stage_id,
  commit_id,
  auto_canceled_by_id,
  traversal_path,
  partition_id,
  {{version_column}} AS _version,
  {{deleted_column}} AS _deleted
FROM siphon_p_ci_builds
WHERE startsWith(traversal_path, {traversal_path:String}) {{filters}}
ORDER BY traversal_path, id, partition_id
LIMIT {{batch_size}}
